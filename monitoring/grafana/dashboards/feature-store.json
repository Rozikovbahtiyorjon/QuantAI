{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(quantai_feature_store_features_logged_total[5m]))",
          "refId": "A"
        }
      ],
      "title": "Features Logged / sec",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(quantai_feature_store_versions_total[1h]))",
          "refId": "A"
        }
      ],
      "title": "Versions Created / h",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(quantai_feature_store_drift_alerts_total[1h]))",
          "refId": "A"
        }
      ],
      "title": "Drift Alerts / h",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantai_feature_store_buffer_size",
          "legendFormat": "{{view}}",
          "refId": "A"
        }
      ],
      "title": "Live Buffer Size",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.2},
              {"color": "red", "value": 0.25}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantai_feature_store_psi",
          "legendFormat": "{{view}}:{{feature}}",
          "refId": "A"
        }
      ],
      "title": "PSI per Feature (threshold 0.2)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "green", "value": 0.1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantai_feature_store_ks_pvalue",
          "legendFormat": "{{view}}:{{feature}}",
          "refId": "A"
        }
      ],
      "title": "KS p-value per Feature (drift if <0.05)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 7,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(quantai_feature_store_drift_check_duration_seconds_bucket[5m])) by (le, view))",
          "legendFormat": "p95 {{view}}",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.5, sum(rate(quantai_feature_store_drift_check_duration_seconds_bucket[5m])) by (le, view))",
          "legendFormat": "p50 {{view}}",
          "refId": "B"
        }
      ],
      "title": "Drift Check Duration",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "green", "value": 600}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 8,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "time() - quantai_feature_store_last_materialize_timestamp",
          "legendFormat": "seconds since last materialize {{view}}",
          "refId": "A"
        }
      ],
      "title": "Time Since Last Materialize",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 20},
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(quantai_feature_store_retrains_total[1h]))",
          "refId": "A"
        }
      ],
      "title": "Drift Retrains / h",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 18, "x": 6, "y": 20},
      "id": 10,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (view, result) (increase(quantai_feature_store_retrains_total[1h]))",
          "legendFormat": "{{view}}:{{result}}",
          "refId": "A"
        }
      ],
      "title": "Retrains by Result",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["feature-store", "drift", "quantai"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(quantai_feature_store_features_logged_total, view)",
        "hide": 0,
        "includeAll": true,
        "label": "View",
        "multi": true,
        "name": "view",
        "options": [],
        "query": {
          "query": "label_values(quantai_feature_store_features_logged_total, view)",
          "refId": "Prometheus-view-query"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "QuantAI — Feature Store",
  "uid": "quantai-feature-store",
  "version": 1,
  "weekStart": ""
}
