# =========================================================
# QuantAI Telegram Office — Quick Start (human language + LLM)
# Copy to .env and fill tokens — NEVER paste keys in chat!
# =========================================================

# 1. Создай бота: @BotFather -> /newbot -> скопируй token
TELEGRAM__ENABLED=true
TELEGRAM__TOKEN=1234567890:AAH...your_bot_token...
TELEGRAM__OFFICE_ENABLED=true

# 2. Создай группу, добавь бота админом, @BotFather -> /setprivacy -> Disable
#    Отправь в группе /whoami — бот ответит chat_id и user_id

# 3. Запри офис:
TELEGRAM__CHAT_ID=-1001234567890
TELEGRAM__ADMIN_IDS=123456789

# 4. Естественный язык — включи LLM (ключ ТОЛЬКО в .env, .gitignore его скрывает):
TELEGRAM__LLM_ENABLED=true
TELEGRAM__LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-...твой_ключ_сюда_вставь_в_файле_.env...

# 5. Безопасность ключа:
#    - Никогда не кидай ключ в Telegram/чат/GitHub — только в файл .env на этом ПК
#    - Ограничь ключ в platform.openai.com -> Limits -> $5, отдельный проект
#    - Если засветил — сразу Regenerate в OpenAI

# Запуск:
#   pip install -r requirements.txt  # подтянет openai + python-telegram-bot
#   python -m src.telegram.office_bot --polling
# Docker:
#   docker compose --profile office up -d telegram-office
#   docker logs -f quantai-telegram-office

# Проверка без LLM (ключевые слова):
#   "как риски?" -> Risk, "проверь архитектуру" -> Architect — работает без ключа
# С LLM — понимает любые фразы: "что-то просадка большая" -> Risk
