# =========================================================
# QuantAI Testnet Environment Variables
# Copy this file to .env.testnet and fill in your values
# =========================================================

# =========================================================
# Binance Testnet API Credentials
# Get from: https://testnet.binancefuture.com/en/futures/api
# =========================================================
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# =========================================================
# Binance Testnet Settings
# =========================================================
BINANCE_TESTNET=true
EXCHANGE=binance
SYMBOL=BTCUSDT
TIMEFRAME=15m
LIMIT=500

# =========================================================
# Account Settings (Testnet)
# =========================================================
INITIAL_BALANCE=10000.0
RISK_PER_TRADE=0.005
MAX_OPEN_POSITIONS=2
MAX_RISK_PERCENT=5.0
MIN_POSITION_SIZE=0.001
MAX_POSITION_SIZE=1.0

# =========================================================
# Commission & Slippage
# =========================================================
COMMISSION=0.0004
SLIPPAGE=0.0002

# =========================================================
# Indicators (Core 4 Only)
# =========================================================
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200

RSI_PERIOD=14
RSI_BUY=55
RSI_SELL=45
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_MULTIPLIER=3.0
TRAILING_STOP_MULTIPLIER=2.0

VOLUME_MA=20
VOLUME_FILTER=1.2

# =========================================================
# Risk Management (Conservative for Testnet)
# =========================================================
RISK_PERCENT=5.0
MAX_RISK_PERCENT=5.0
RISK_REWARD_RATIO=2.0
MAX_DRAWDOWN_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=30.0
MAX_POSITION_EXPOSURE_PCT=3.0
MAX_DAILY_LOSS_PCT=2.0

# =========================================================
# Backtest Settings
# =========================================================
ENABLE_TRAILING_STOP=true
ENABLE_BREAK_EVEN=true
ENABLE_PARTIAL_CLOSE=false
RISK_REWARD_RATIO=2.0

# =========================================================
# Machine Learning
# =========================================================
ML_ENABLED=true
MODEL_PATH=models/quantai_v5.pkl
ML_CV_TYPE=purged
ML_N_SPLITS=5
ML_EMBARGO_PCT=0.01
ML_PURGE_PCT=0.0
ML_N_TEST_FOLDS=2
ML_TEST_SIZE=0.20
ML_RANDOM_STATE=42
ML_N_ESTIMATORS=300
ML_MAX_DEPTH=6
ML_LEARNING_RATE=0.05
ML_SUBSAMPLE=0.9
ML_COLSAMPLE_BYTREE=0.9
ML_USE_CLASS_WEIGHTS=true

# =========================================================
# Telegram (Optional)
# =========================================================
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================================
# Logging
# =========================================================
LOG_LEVEL=DEBUG
SAVE_TRADES=true
TRADES_FILE=trades_testnet.csv

# =========================================================
# Monitoring & Alerting
# SECURITY: Grafana/Postgres/Redis passwords MUST be set via env — docker-compose fails startup if missing
# Do NOT use 'admin'/'quantai123' — generate strong random passwords
# Example: openssl rand -base64 24
# =========================================================
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=CHANGE_ME__SET_STRONG_RANDOM_PASSWORD_HERE__REQUIRED
REDIS_PASSWORD=CHANGE_ME__SET_STRONG_RANDOM_PASSWORD_HERE__REQUIRED
POSTGRES_PASSWORD=CHANGE_ME__SET_STRONG_RANDOM_PASSWORD_HERE__REQUIRED
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=quantai-alerts@yourdomain.com
ALERT_EMAIL=your_email@gmail.com
CRITICAL_ALERT_EMAIL=your_email@gmail.com
WARNING_ALERT_EMAIL=your_email@gmail.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX
PAGERDUTY_KEY=

# =========================================================
# Binance Testnet API
# =========================================================
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here