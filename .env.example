# =====================================================
# QuantAI Environment Configuration
# Copy to .env and fill in your values
# =====================================================

# Project
PROJECT_NAME=QuantAI
VERSION=5.0.0

# Exchange
EXCHANGE__EXCHANGE=binance
EXCHANGE__SYMBOL=BTC/USDT
EXCHANGE__TIMEFRAME=15m
EXCHANGE__LIMIT=1000

# Account
ACCOUNT__INITIAL_BALANCE=1000.0
ACCOUNT__RISK_PER_TRADE=0.01
ACCOUNT__MAX_OPEN_POSITIONS=1
ACCOUNT__MAX_RISK_PERCENT=1.0
ACCOUNT__MIN_POSITION_SIZE=0.001
ACCOUNT__MAX_POSITION_SIZE=1.0

# Commission
COMMISSION__COMMISSION=0.0004
COMMISSION__SLIPPAGE=0.0002

# Indicators - EMA
INDICATORS__EMA_FAST=20
INDICATORS__EMA_SLOW=50
INDICATORS__EMA_TREND=200

# Indicators - RSI
INDICATORS__RSI_PERIOD=14
INDICATORS__RSI_BUY=55
INDICATORS__RSI_SELL=45
INDICATORS__RSI_OVERBOUGHT=70
INDICATORS__RSI_OVERSOLD=30

# Indicators - MACD
INDICATORS__MACD_FAST=12
INDICATORS__MACD_SLOW=26
INDICATORS__MACD_SIGNAL=9

# Indicators - ATR
INDICATORS__ATR_PERIOD=14
INDICATORS__ATR_STOP_MULTIPLIER=1.5
INDICATORS__ATR_TAKE_MULTIPLIER=3.0
INDICATORS__TRAILING_STOP_MULTIPLIER=2.0

# Indicators - ADX
INDICATORS__ADX_PERIOD=14
INDICATORS__ADX_MIN=25

# Indicators - Bollinger
INDICATORS__BB_PERIOD=20
INDICATORS__BB_STD=2.0

# Indicators - Volume
INDICATORS__VOLUME_MA=20
INDICATORS__VOLUME_FILTER=1.2

# Indicators - SuperTrend
INDICATORS__SUPERTREND_PERIOD=10
INDICATORS__SUPERTREND_MULTIPLIER=3.0

# Backtest
BACKTEST__ENABLE_TRAILING_STOP=true
BACKTEST__ENABLE_BREAK_EVEN=true
BACKTEST__ENABLE_PARTIAL_CLOSE=false
BACKTEST__RISK_REWARD_RATIO=2.0

# Machine Learning
ML__ML_ENABLED=false
ML__MODEL_PATH=models/quantai_v5.pkl
ML__CV_TYPE=purged
ML__N_SPLITS=5
ML__EMBARGO_PCT=0.01
ML__PURGE_PCT=0.0
ML__N_TEST_FOLDS=2
ML__TEST_SIZE=0.20
ML__RANDOM_STATE=42
ML__N_ESTIMATORS=300
ML__MAX_DEPTH=6
ML__LEARNING_RATE=0.05
ML__SUBSAMPLE=0.90
ML__COLSAMPLE_BYTREE=0.90
ML__USE_CLASS_WEIGHTS=true

# Telegram (fill in your bot token and chat ID)
TELEGRAM__ENABLED=false
TELEGRAM__TOKEN=
TELEGRAM__CHAT_ID=

# Logging
LOGGING__LOG_LEVEL=INFO
LOGGING__SAVE_TRADES=true
LOGGING__TRADES_FILE=trades.csv

# Risk
RISK__DRAWDOWN_LIMIT_PCT=10.0
RISK__MAX_CORRELATION=0.85
RISK__MAX_CORRELATED_ASSETS=2
RISK__POSITION_SIZER_METHOD=fixed_fractional

# Binance API (for live trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=